# Brevo Transactional Email (same provider as RS Graphic Design)
# Copy to `.env` for local testing with `node dev-server.js`
# (`.env` is gitignored — never commit secrets)
# Also set these in Vercel → Project → Settings → Environment Variables

# Required — Brevo dashboard → SMTP & API → API keys
BREVO_API_KEY=

# Optional — verified Brevo sender
RFQ_FROM_EMAIL=updates.from.kawsar@gmail.com
RFQ_FROM_NAME=Manual Vector Tracing

# Quote TO is hardcoded in api/contact.js to rsstudiobd@gmail.com
# RFQ_TO_EMAIL is ignored if set.
