# Brevo Transactional Email (same provider as RS Graphic Design)
# Copy to `.env` for local testing with `node dev-server.js`
# (`.env` is gitignored — never commit secrets)
# Also set these in Vercel → Project → Settings → Environment Variables

# Required — Brevo dashboard → SMTP & API → API keys
BREVO_API_KEY=

# Optional — verified Brevo sender
RFQ_FROM_EMAIL=updates.from.kawsar@gmail.com
RFQ_FROM_NAME=Manual Vector Tracing

# Quote TO is hardcoded in api/contact.js to info@manualvectortracing.com
# RFQ_TO_EMAIL is ignored if set.

# Cloudflare R2 (quote file uploads — S3-compatible)
# Dashboard → R2 → Manage R2 API Tokens → Create API token (Object Read & Write)
R2_ACCOUNT_ID=9e6d1b2cec32b268a9c3be2f087cc238
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=manual-vector-tracing

# Permanent download links in email use SITE_URL/api/download?key=...
# (does not expire; each click redirects to a fresh short R2 URL)
SITE_URL=https://manualvectortracing.com
