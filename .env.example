# Brevo Transactional Email (same provider as RS Graphic Design)
# Set these in Vercel → Project → Settings → Environment Variables

# Required — Brevo dashboard → SMTP & API → API keys
BREVO_API_KEY=

# Optional — defaults shown
RFQ_TO_EMAIL=hello@manualvectortracing.com
RFQ_TO_NAME=Sales Team
RFQ_FROM_EMAIL=noreply@manualvectortracing.com
RFQ_FROM_NAME=Manual Vector Tracing
